# ============================================================================
# el_Moultaqa — Environment Variables Template
# ============================================================================
# Copy this file to .env.local in each app directory (webapp/, admin/, Landing/)
# and fill in your actual values. NEVER commit .env.local files.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (client-side — safe to expose)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-SUPABASE-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# Clerk (client-side — safe to expose)
# ---------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_... (your publishable key)


# ---------------------------------------------------------------------------
# Edge Function Secrets (server-side only — set via `supabase secrets set`)
# DO NOT put these in .env.local — they are for Supabase Edge Functions only.
# ---------------------------------------------------------------------------

# SMTP Configuration for send-notification edge function
# Uses Gmail SMTP as example — replace with your SMTP provider
# For Gmail: use smtp.gmail.com, port 587, and an App Password (not your regular password)
# See: https://support.google.com/accounts/answer/185833
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=your-email@gmail.com
#SMTP_PASS=your-app-password
#SMTP_FROM_EMAIL=your-email@gmail.com
#SMTP_FROM_NAME=ElMoultaqa Super Admin

# ---------------------------------------------------------------------------
# Live Stream Settings
# ---------------------------------------------------------------------------
VITE_STREAM_URL=http://4.233.144.150/live/index.m3u8
